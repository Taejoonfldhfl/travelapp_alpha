<?xml version="1.0" encoding="utf-8"?>
<!-- 티켓 DB는 Keystore 키로 암호화된 값을 담고 있어 다른 기기로 복원되면 복호화할 수 없으므로 백업에서 제외한다. -->
<full-backup-content>
    <exclude domain="database" path="ticket.db" />
    <exclude domain="database" path="ticket.db-shm" />
    <exclude domain="database" path="ticket.db-wal" />
    <exclude domain="sharedpref" path="ticket_keyset.xml" />
</full-backup-content>
